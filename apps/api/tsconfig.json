{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "rootDir": "../../",
    "outDir": "./dist",
    "paths": {
      "@vertex/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
